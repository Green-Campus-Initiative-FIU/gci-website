rules_version = '2';

// All Firestore reads/writes go through the server (Firebase Admin SDK),
// which bypasses these rules. The browser only uses Firebase Auth, so
// direct client access to the database is denied entirely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
