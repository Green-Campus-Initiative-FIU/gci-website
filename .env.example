# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Firebase Admin SDK service account (JSON string) *must be one line only*
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Firebase Client SDK config (public)
# Firebase Console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""

# Cloudinary (stores user profile pictures; avoids needing Firebase's paid Blaze plan)
# Cloudinary Console > Settings > API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
